                </mxCell>
                <mxCell id="4-2" value="Routes, timeouts, retries, splits and fault injection are configured in the mesh, not in the app. Retries are where the mesh meets this experiment&#39;s rule." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/>
                </mxCell>
