                <mxCell id="5-32" value="schema-apply, duplicate-audit" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="990" y="760" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5-33" value="kube-dns :53" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="570" y="780" width="150" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="5-34" value="otel-agent :4317" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="760" y="780" width="150" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="5-35" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-27" target="5-30">
                    <mxGeometry x="-0.6" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="590" y="582"/>
                            <mxPoint x="590" y="602"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="5-36" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-28" target="5-30">
                    <mxGeometry x="-0.6" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="605" y="647"/>
                            <mxPoint x="605" y="623"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="5-37" value="denied" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=cross;endFill=0;endSize=10;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-29" target="5-30">
                    <mxGeometry x="-0.6" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="620" y="712"/>
                            <mxPoint x="620" y="644"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="5-38" value="allow 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-31">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5-39" value="allow 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-32" target="5-31">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5-40" value="allow 53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-33">
                    <mxGeometry x="-0.2" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5-41" value="allow 4317" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-34">
                    <mxGeometry x="-0.2" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5-42" value="Everything else is denied, including the other stacks reaching python." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="360" y="845" width="420" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="5-43" value="allow 5432 (harness counts)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;strokeColor=#64748B;dashed=1;fontColor=#64748B;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-27" target="5-31">
                    <mxGeometry x="0.1" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="445" y="532"/>
                            <mxPoint x="1075" y="532"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="5-44" value="&lt;b&gt;Start from deny-all&lt;/b&gt; for ingress and egress in wcf-physics, then add one rule per arrow. With ambient mode, also allow port 15008 (HBONE) and the kubelet probe address 169.254.7.127. Risk to prove first: NodePort traffic from the host arrives from the node&#39;s address, so the host rules must allow it or k6 and the harness lose access." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="560" width="350" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="5-45" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="900" width="1540" height="265" as="geometry"/>
                </mxCell>
                <mxCell id="5-46" value="3 · Istio identity" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="914" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="5-47" value="Who is really calling? Proven by the mTLS certificate each pod gets from istiod, and checked by AuthorizationPolicy." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="950" width="260" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="5-48" value="&lt;b&gt;PeerAuthentication&lt;/b&gt; STRICT for wcf-physics: pods accept only mTLS from mesh workloads. The host&#39;s plain HTTP must enter through the gateway, or the NodePorts need a PERMISSIVE exception (a decision for the author)." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
                    <mxGeometry x="340" y="930" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="5-49" value="&lt;b&gt;AuthorizationPolicy on postgres&lt;/b&gt; (L4, enforced by ztunnel): ALLOW port 5432 from &lt;i&gt;cluster.local/ns/wcf-physics/sa/&lt;/i&gt; python, dotnet, java, schema-job, duplicate-audit. Everything else is denied." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
                    <mxGeometry x="750" y="930" width="400" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="5-50" value="&lt;b&gt;AuthorizationPolicy on python&lt;/b&gt; (L7, enforced by the waypoint): ALLOW from the gateway&#39;s identity, only POST /naive/bookings, POST /v2/bookings and GET /health." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
                    <mxGeometry x="1180" y="930" width="370" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="5-51" value="&lt;b&gt;Why three layers:&lt;/b&gt; RBAC stops a compromised pod from reading Secrets or scaling Deployments; NetworkPolicy stops connections even if a pod leaves the mesh; Istio stops a pod that can reach the network but holds the wrong identity, and encrypts the traffic." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="340" y="1085" width="1210" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-5" name="6 OpenTelemetry and dashboard">
        <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1360" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="6-1" value="6 · OpenTelemetry and the dashboard: services, pods and scale" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="6-2" value="The app sends traces and metrics over OTLP; a collector on each node adds pod and node data; one backend stores it and Grafana shows it." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="6-3" value="sources" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="40" y="130" width="300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="6-4" value="collectors" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="540" y="130" width="300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="6-5" value="backend" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="130" width="300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="6-6" value="&lt;b&gt;pod python&lt;/b&gt;&lt;br&gt;OTel SDK in bootstrap; FastAPI and asyncpg instrumentation; outcome counter in the HTTP adapter" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="170" width="340" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6-7" value="&lt;b&gt;kubelet&lt;/b&gt; on the node&lt;br&gt;pod and container CPU, memory, network" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="270" width="340" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="6-8" value="&lt;b&gt;container logs&lt;/b&gt;&lt;br&gt;/var/log/pods on the node" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="350" width="340" height="60" as="geometry"/>
                </mxCell>
