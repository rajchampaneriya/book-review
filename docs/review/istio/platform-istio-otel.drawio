                <mxCell id="4-32" value="booking + charge, committed" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1">
