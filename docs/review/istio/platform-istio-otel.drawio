                <mxCell id="1" parent="0"/>
                <mxCell id="3-1" value="3 · Service discovery and one booking request" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
