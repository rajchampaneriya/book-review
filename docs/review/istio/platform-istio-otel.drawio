                </mxCell>
                <mxCell id="4-34" value="" style="ellipse;fillColor=#1E3A8A;strokeColor=#1E3A8A;html=1;" vertex="1" parent="1">
                    <mxGeometry x="1142" y="344" width="12" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="4-35" value="retry policy fires" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;" vertex="1" parent="1">
                    <mxGeometry x="1122" y="385" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="4-36" value="try 2, same request" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1116" y="425" as="sourcePoint"/>
                        <mxPoint x="1284" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="4-37" value="key seen: read the stored result" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1296" y="460" as="sourcePoint"/>
                        <mxPoint x="1464" y="460" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="4-38" value="201 + Idempotent-Replayed: true" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1284" y="500" as="sourcePoint"/>
                        <mxPoint x="1116" y="500" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="4-39" value="201" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1104" y="540" as="sourcePoint"/>
                        <mxPoint x="936" y="540" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="4-40" value="One booking, one charge. The key turns the resend into a replay." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="850" y="560" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="4-41" value="Route rules for the booking services" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="625" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="4-42" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="665" width="330" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="4-43" value="Timeouts" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="46" y="678" width="298" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="4-44" value="A route timeout bounds how long the proxy waits. The spec&#39;s client timeout (1 s) stays in k6, so the experiment still sees the same lost replies." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="46" y="710" width="298" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="4-45" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="380" y="665" width="520" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="4-46" value="Retries" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="396" y="678" width="488" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="4-47" value="&lt;b&gt;/v2/bookings&lt;/b&gt;: retries on reset or 503 are safe, because every try carries the same key. &lt;b&gt;/naive/bookings&lt;/b&gt;: set attempts to 0 so the control group stays naive. Istio&#39;s default (2 retries on connection failures, refused streams and retriable codes) targets requests the app never processed; adding reset, 5xx or a per-try timeout can resend a committed request." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="396" y="710" width="488" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="4-48" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="920" y="665" width="330" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="4-49" value="Traffic split" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="936" y="678" width="298" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="4-50" value="Weighted routes send, say, 10% of /v2 traffic to a new python version. Watch errors and p99 per version on the dashboard before moving more." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="936" y="710" width="298" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="4-51" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1270" y="665" width="330" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="4-52" value="Fault injection" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1286" y="678" width="298" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="4-53" value="The mesh can delay or abort requests, but it does so before the request reaches the app: nothing is booked yet. The experiment needs the reply held after the commit, which only the app&#39;s fault hook can do." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1286" y="710" width="298" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="4-54" value="Where the delay happens decides whether a retry duplicates" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="870" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="4-55" value="Mesh fault injection&lt;br&gt;(delay before the app)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="30" y="930" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="4-56" value="proxy holds the request 2 s" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="330" y="934" width="720" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4-57" value="reaches app" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1050" y="934" width="90" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4-58" value="At 1 s the client gives up while nothing is booked yet. The test never reaches the case it exists for: a committed booking whose reply was lost." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="930" width="410" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="4-59" value="App fault hook&lt;br&gt;(the experiment: hold after commit)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="30" y="1030" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="4-60" value="app books" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="330" y="1034" width="90" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4-61" value="app holds the reply 2 s" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="420" y="1034" width="720" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4-62" value="Client gives up at 1 s and retries while the first booking already exists: the naive endpoint books again; the keyed endpoint replays." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="1030" width="410" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="4-63" value="client timeout (1 s)" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=none;verticalAlign=top;" edge="1" parent="1">
                    <mxGeometry x="1" relative="1" as="geometry">
                        <mxPoint x="0" y="6" as="offset"/>
                        <mxPoint x="690" y="915" as="sourcePoint"/>
                        <mxPoint x="690" y="1105" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="4-64" value="0 s" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="322" y="1100" width="30" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="4-65" value="2 s" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1042" y="1100" width="30" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="4-66" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;strokeColor=#64748B;endArrow=open;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="330" y="1092" as="sourcePoint"/>
                        <mxPoint x="1194" y="1092" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-4" name="5 Security in three layers">
        <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1195" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="5-1" value="5 · Security in three layers: API access, network reach, workload identity" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="5-2" value="Each layer answers a different question, and each one would stop a mistake the others miss." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="5-3" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="130" width="1540" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="5-4" value="1 · Kubernetes RBAC" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="144" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="5-5" value="Who may call the Kubernetes API, and do what? Enforced by the API server for every ServiceAccount and user." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="180" width="260" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="5-6" value="ServiceAccount or user" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="340" y="145" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="5-7" value="granted" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="690" y="145" width="470" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="5-8" value="why" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="145" width="360" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="5-9" value="sa/python, postgres, schema-job, duplicate-audit" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="340" y="172" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-10" value="no Role; token not mounted" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="690" y="172" width="470" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-11" value="They never need the API." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="172" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-12" value="sa/otel-agent" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="340" y="234" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-13" value="ClusterRole: get, list, watch pods, namespaces, nodes, nodes/stats, replicasets" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="690" y="234" width="470" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-14" value="Reads pod CPU and memory from the kubelet and labels telemetry with pod and Deployment names." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="234" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-15" value="sa/otel-cluster" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="340" y="296" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-16" value="ClusterRole: get, list, watch Deployments, ReplicaSets, DaemonSets, Jobs, CronJobs, pods, nodes" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="690" y="296" width="470" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-17" value="Reports desired and ready replicas, restarts and pod phase." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="296" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-18" value="sa/matrix-runner (optional)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="340" y="358" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-19" value="Role in wcf-physics: get and patch deployments/scale, only dotnet, java, python" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="690" y="358" width="470" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-20" value="Lets the matrix scale stacks without cluster-admin, if it ever runs in-cluster." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="358" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-21" value="you (kubeconfig)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="340" y="420" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-22" value="cluster-admin on your local k3d cluster" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="690" y="420" width="470" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-23" value="make up, make deploy, make exp3-all." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="420" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5-24" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="30" y="510" width="1540" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="5-25" value="2 · NetworkPolicy" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="524" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="5-26" value="Which pods and ports may open a connection? Enforced on the node by k3s&#39;s built-in kube-router controller, below the mesh." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="50" y="560" width="260" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="5-27" value="host (NodePorts)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
