                    <mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="3-3" value="&lt;b&gt;sd&lt;/b&gt; Discover python and book a session (ambient mode)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=470;height=30;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Helvetica;" vertex="1" parent="1">
