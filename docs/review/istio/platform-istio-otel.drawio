                <mxCell id="3-31" value="201 Created + booking" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="769" y="830" as="sourcePoint"/>
                        <mxPoint x="566" y="830" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3-32" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="554" y="865" as="sourcePoint"/>
                        <mxPoint x="351" y="865" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3-33" value="201 Created (a retry gets Idempotent-Replayed: true)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="339" y="900" as="sourcePoint"/>
                        <mxPoint x="136" y="900" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="3-34" value="&lt;b&gt;Discovery&lt;/b&gt; is the Kubernetes Service name plus xDS. The client still asks for python.wcf-physics.svc; the proxies already know which pods are ready, so they load-balance across them and drop pods that fail readiness." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="40" y="965" width="470" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="3-35" value="&lt;b&gt;One ztunnel per node&lt;/b&gt; serves every pod on that node, so the same lifeline carries both legs. In sidecar mode each pod has its own Envoy instead, and the gateway talks to python&#39;s sidecar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="540" y="965" width="470" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="3-36" value="&lt;b&gt;Identity&lt;/b&gt; comes from the pod&#39;s ServiceAccount. That is why the plan gives every workload its own account: AuthorizationPolicy names accounts, not IP addresses." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1040" y="965" width="520" height="75" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-3" name="4 Traffic management">
