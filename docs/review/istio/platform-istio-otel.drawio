                </mxCell>
                <mxCell id="4-33" value="reply lost (connection reset)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
