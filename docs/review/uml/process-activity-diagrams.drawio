                <mxCell id="0-6" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;b&gt;Flow final node&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;This one path ends; other paths carry on.&lt;/font&gt;" vertex="1">
