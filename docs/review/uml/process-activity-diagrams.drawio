                <mxCell id="0-7" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;b&gt;Action&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;One step that a person or a system carries out.&lt;/font&gt;" vertex="1">
