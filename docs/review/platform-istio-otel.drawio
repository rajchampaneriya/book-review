atabase time per request&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;heatmap from asyncpg spans&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1258" y="800" width="290" height="120" as="geometry"/></mxCell><mxCell id="6-33" value="Pods and scale" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="945" width="400" height="24" as="geometry"/></mxCell><mxCell id="6-34" value='&lt;b&gt;Ready replicas per Deployment&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;state timeline&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="975" width="290" height="120" as="geometry"/></mxCell><mxCell id="6-35" value='&lt;b&gt;CPU used vs request 1 and limit 2&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;time series&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="352" y="975" width="290" height="120" as="geometry"/></mxCell><mxCell id="6-36" value='&lt;b&gt;Memory used vs limit 1 Gi&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;time series&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8