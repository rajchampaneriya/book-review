<mxfile host="drawio" agent="review generator" version="24.7.0"><diagram id="page-0" name="1 Objects today and planned"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="880" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1-1" value="1 · Kubernetes objects for the Python stack: today and planned" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1100" height="40" as="geometry"/></mxCell><mxCell id="1-2" value="What infra/k8s defines today and what the platform plan would add. Files marked new must first be added to the CLAUDE.md tree by the author." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1100" height="48" as="geometry"/></mxCell><mxCell id="1-3" value="exists" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="64" width="80" height="24" as="geometry"/></mxCell><mxCell id="1-4" value="in the repo today" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1088" y="64" width="130" height="24" as="geometry"/></mxCell><mxCell id="1-5" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="64" width="80" height="24" as="geometry"/></mxCell><mxCell id="1-6" value="proposed by the plan; not built" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1318" y="64" width="220" height="24" as="geometry"/></mxCell><mxCell id="1-7" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-8" value="Namespace" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="154" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-9" value="exists" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="295" y="156" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-10" value="&lt;b&gt;wcf-physics&lt;/b&gt; holds Postgres and the three stacks. Planned: label it &lt;i&gt;istio.io/dataplane-mode=ambient&lt;/i&gt; so its pods join the mesh." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="202" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-11" value="infra/k8s/namespace.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="56" y="327" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-12" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="415" y="140" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-13" value="Deployment" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="154" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-14" value="exists" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="156" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-15" value="&lt;b&gt;python&lt;/b&gt;: 1 replica, CPU request 1 and limit 2, memory 1 Gi, readiness probe on /health. Planned: its own ServiceAccount, a non-root securityContext, and the database password read from the Secret." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="202" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-16" value="infra/k8s/python.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="431" y="327" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-17" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-18" value="Service" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="154" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-19" value="exists" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1045" y="156" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-20" value="NodePort 30083 to container port 8080; host port 8083 reaches it through k3d. Inside the cluster it is &lt;b&gt;python.wcf-physics.svc:8080&lt;/b&gt;, the name Istio discovers and routes on. Planned: name the port &lt;i&gt;http&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="202" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-21" value="infra/k8s/python.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="806" y="327" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-22" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1165" y="140" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-23" value="Secret" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="154" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-24" value="exists" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="156" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-25" value="&lt;b&gt;postgres-local&lt;/b&gt; holds labelled local-development defaults (rule G7). Gap: the python Deployment repeats the password inline in DATABASE_URL instead of reading it from this Secret." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="202" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-26" value="infra/k8s/postgres.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1181" y="327" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-27" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-28" value="ServiceAccount" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="399" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-29" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="295" y="401" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-30" value="One per workload: python, postgres, schema-job, duplicate-audit, otel-agent, otel-cluster; no API token mounted unless it is needed. Istio turns each one into the pod's identity: &lt;i&gt;spiffe://cluster.local/ns/wcf-physics/sa/python&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="447" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-31" value="new: infra/k8s/rbac.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="56" y="572" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-32" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="415" y="385" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-33" value="RBAC: Role, ClusterRole, bindings" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="399" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-34" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="401" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-35" value="Today every pod runs as the namespace's default account. Planned: the services get no API rights; the collectors may only read pods, nodes, namespaces and node stats; an optional matrix-runner Role may only scale the three stack Deployments." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="447" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-36" value="new: infra/k8s/rbac.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="431" y="572" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-37" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="790" y="385" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-38" value="NetworkPolicy" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="399" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-39" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1045" y="401" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-40" value="k3s enforces NetworkPolicy out of the box with its embedded kube-router controller. Planned: deny by default, then allow the host and gateway to python:8080, python to postgres:5432, DNS and the collector, and nothing else." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="447" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-41" value="new: infra/k8s/network-policy.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="806" y="572" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-42" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1165" y="385" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-43" value="Job" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="399" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-44" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="401" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-45" value="&lt;b&gt;schema-apply&lt;/b&gt;: runs db/schema.sql once per stack schema inside the cluster, replacing the &lt;i&gt;kubectl exec&lt;/i&gt; in apply-schema.sh. &lt;i&gt;make up&lt;/i&gt; waits for it to complete." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="447" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-46" value="new: infra/k8s/schema-job.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1181" y="572" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-47" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-48" value="CronJob" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="644" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-49" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="295" y="646" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-50" value="&lt;b&gt;duplicate-audit&lt;/b&gt; (your choice): every few minutes, count bookings per client reference in each schema and publish the duplicates as a metric. Read-only, suspended during measured runs. Alternative: delete old request keys, which changes the spec." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="692" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-51" value="new: infra/k8s/duplicate-audit.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="56" y="817" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-52" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="415" y="630" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-53" value="DaemonSet" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="644" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-54" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="646" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-55" value="&lt;b&gt;otel-agent&lt;/b&gt;: one OpenTelemetry Collector per node that reads pod CPU and memory from the kubelet, container logs, and the app's spans and metrics. Istio's ztunnel and istio-cni run as DaemonSets too." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="431" y="692" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-56" value="new: infra/observability/otel-agent.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="431" y="817" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-57" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="790" y="630" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-58" value="Istio access policy" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="644" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-59" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1045" y="646" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-60" value="&lt;b&gt;PeerAuthentication&lt;/b&gt;: mTLS between pods. &lt;b&gt;AuthorizationPolicy&lt;/b&gt;: postgres accepts only the stacks, the schema Job and the audit; python accepts only the gateway, and only the booking and health routes." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="806" y="692" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-61" value="new: infra/mesh/security.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="806" y="817" width="323" height="24" as="geometry"/></mxCell><mxCell id="1-62" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1165" y="630" width="355" height="225" as="geometry"/></mxCell><mxCell id="1-63" value="Istio traffic rules" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="644" width="225" height="44" as="geometry"/></mxCell><mxCell id="1-64" value="planned" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;fontColor=#3B82F6;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="646" width="84" height="24" as="geometry"/></mxCell><mxCell id="1-65" value="&lt;b&gt;Gateway&lt;/b&gt;: one entry point for traffic from the host. &lt;b&gt;Routes&lt;/b&gt;: timeouts, retries only on the keyed endpoint, and weighted splits between versions (canary)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1181" y="692" width="323" height="115" as="geometry"/></mxCell><mxCell id="1-66" value="new: infra/mesh/traffic.yaml" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B82F6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1181" y="817" width="323" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="2 Istio in this cluster"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-1" value="2 · Istio in this cluster: ambient mode" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="2-2" value="istiod is the control plane. In ambient mode a ztunnel on each node carries every pod's traffic over mTLS, and a waypoint proxy adds HTTP-level rules only where you ask for them." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/></mxCell><mxCell id="2-3" value="Your Mac (host)" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="300" height="470" as="geometry"/></mxCell><mxCell id="2-4" value='&lt;b&gt;k6&lt;/b&gt; load script&lt;br&gt;&lt;font color="#64748B"&gt;harness/k6/exp3.js&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="190" width="250" height="60" as="geometry"/></mxCell><mxCell id="2-5" value='&lt;b&gt;harness&lt;/b&gt; and contract tests&lt;br&gt;&lt;font color="#64748B"&gt;count rows in Postgres&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="290" width="250" height="60" as="geometry"/></mxCell><mxCell id="2-6" value='&lt;b&gt;kubectl, helm, istioctl&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;install and configure&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="390" width="250" height="60" as="geometry"/></mxCell><mxCell id="2-7" value="Host ports 8081 to 8083 and 55432 map to NodePorts through k3d (infra/k3d/cluster.yaml)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="480" width="250" height="60" as="geometry"/></mxCell><mxCell id="2-8" value="For comparison: sidecar mode" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="300" height="450" as="geometry"/></mxCell><mxCell id="2-9" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="250" height="150" as="geometry"/></mxCell><mxCell id="2-10" value="pod python" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="696" width="200" height="20" as="geometry"/></mxCell><mxCell id="2-11" value="app container&lt;br&gt;:8080" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="725" width="105" height="60" as="geometry"/></mxCell><mxCell id="2-12" value="Envoy sidecar&lt;br&gt;L4 + L7" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="185" y="725" width="105" height="60" as="geometry"/></mxCell><mxCell id="2-13" value="Envoy runs inside every pod. Each pod gets L4 and L7 features, but pods restart to be injected and every replica pays the proxy's CPU and memory." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="855" width="250" height="90" as="geometry"/></mxCell><mxCell id="2-14" value="&lt;b&gt;Ambient&lt;/b&gt; (recommended here): one ztunnel per node for mTLS and L4 policy, and a waypoint only for the namespaces that need retries, timeouts or HTTP rules." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="55" y="960" width="250" height="110" as="geometry"/></mxCell><mxCell id="2-15" value="k3d cluster wcf-physics: one k3s server node inside Docker" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="1200" height="1000" as="geometry"/></mxCell><mxCell id="2-16" value="namespace istio-system" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="185" width="520" height="200" as="geometry"/></mxCell><mxCell id="2-17" value="&lt;b&gt;istiod&lt;/b&gt;&lt;br&gt;control plane: discovery, configuration (xDS), certificates" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="2-18" value="Installed with Helm charts base, istiod, cni and ztunnel, with &lt;i&gt;global.platform=k3d&lt;/i&gt;. Traefik is turned off so it does not clash with the gateway." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="710" y="225" width="195" height="95" as="geometry"/></mxCell><mxCell id="2-19" value="namespace observability (page 6)" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="185" width="590" height="200" as="geometry"/></mxCell><mxCell id="2-20" value="&lt;b&gt;otel-cluster&lt;/b&gt;&lt;br&gt;Deployment" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="235" width="160" height="60" as="geometry"/></mxCell><mxCell id="2-21" value="&lt;b&gt;lgtm&lt;/b&gt;&lt;br&gt;Grafana, metrics, traces, logs" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="235" width="200" height="60" as="geometry"/></mxCell><mxCell id="2-22" value="You open Grafana from the host." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="245" width="150" height="50" as="geometry"/></mxCell><mxCell id="2-23" value="namespace wcf-physics  (label istio.io/dataplane-mode=ambient)" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#64748B;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=right;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1140" height="440" as="geometry"/></mxCell><mxCell id="2-24" value="&lt;b&gt;Ingress gateway&lt;/b&gt;&lt;br&gt;Envoy, created from a Gateway API &lt;i&gt;Gateway&lt;/i&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="210" height="70" as="geometry"/></mxCell><mxCell id="2-25" value="&lt;b&gt;waypoint&lt;/b&gt; (optional)&lt;br&gt;L7: routes, retries, timeouts, HTTP policy" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="2-26" value='&lt;b&gt;pod python&lt;/b&gt;&lt;br&gt;FastAPI on :8080&lt;br&gt;&lt;font color="#DBEAFE"&gt;identity sa/python&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="2-27" value='&lt;b&gt;pod postgres&lt;/b&gt;&lt;br&gt;:5432&lt;br&gt;&lt;font color="#64748B"&gt;identity sa/postgres&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="460" width="200" height="110" as="geometry"/></mxCell><mxCell id="2-28" value="&lt;b&gt;dotnet&lt;/b&gt; and &lt;b&gt;java&lt;/b&gt; pods&lt;br&gt;same pattern" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="620" width="220" height="60" as="geometry"/></mxCell><mxCell id="2-29" value="&lt;b&gt;schema-apply&lt;/b&gt; Job" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="620" width="200" height="50" as="geometry"/></mxCell><mxCell id="2-30" value="&lt;b&gt;duplicate-audit&lt;/b&gt; CronJob" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="690" width="200" height="50" as="geometry"/></mxCell><mxCell id="2-31" value="The app code does not change: it still calls postgres:5432. ztunnel captures the traffic, wraps it in mTLS (HBONE, port 15008) and checks policy on both ends." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="600" width="520" height="70" as="geometry"/></mxCell><mxCell id="2-32" value="Every pod keeps its Kubernetes Service name; Istio adds identity and policy around it." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="520" height="40" as="geometry"/></mxCell><mxCell id="2-33" value="node layer: DaemonSets, one pod per node" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="1140" height="200" as="geometry"/></mxCell><mxCell id="2-34" value="&lt;b&gt;ztunnel&lt;/b&gt;&lt;br&gt;L4 mTLS tunnel (HBONE :15008), L4 policy, TCP metrics" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="950" width="300" height="80" as="geometry"/></mxCell><mxCell id="2-35" value="&lt;b&gt;istio-cni&lt;/b&gt;&lt;br&gt;redirects each pod's traffic to ztunnel" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="950" width="260" height="80" as="geometry"/></mxCell><mxCell id="2-36" value="&lt;b&gt;otel-agent&lt;/b&gt;&lt;br&gt;planned collector (page 6)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="950" width="220" height="80" as="geometry"/></mxCell><mxCell id="2-37" value="&lt;b&gt;k3s built-ins&lt;/b&gt;&lt;br&gt;flannel networking, kube-router NetworkPolicy" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="950" width="220" height="80" as="geometry"/></mxCell><mxCell id="2-38" value="NetworkPolicy still applies underneath the mesh; ambient needs port 15008 and the probe address 169.254.7.127 allowed." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="1045" width="840" height="40" as="geometry"/></mxCell><mxCell id="2-39" value="HTTP :8083" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-4" target="2-24"><mxGeometry x="0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="220"/><mxPoint x="355" y="515"/></Array></mxGeometry></mxCell><mxCell id="2-40" value="SQL counts via NodePort 30432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;strokeColor=#64748B;dashed=1;fontColor=#64748B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-5" target="2-27"><mxGeometry x="0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="375"/><mxPoint x="345" y="375"/><mxPoint x="345" y="880"/><mxPoint x="1555" y="880"/><mxPoint x="1555" y="515"/></Array></mxGeometry></mxCell><mxCell id="2-41" value="mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-24" target="2-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2-42" value="mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-25" target="2-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2-43" value="SQL, mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-26" target="2-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2-44" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=open;edgeStyle=orthogonalEdgeStyle;exitX=0.40384615384615385;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-17" target="2-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2-45" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=open;edgeStyle=orthogonalEdgeStyle;exitX=0.9230769230769231;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-17" target="2-25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="402"/><mxPoint x="830" y="402"/></Array></mxGeometry></mxCell><mxCell id="2-46" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=open;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-17" target="2-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="270"/><mxPoint x="415" y="990"/></Array></mxGeometry></mxCell><mxCell id="2-47" value="dashed: configuration and certificates pushed by istiod (xDS)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="215" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="3 Discovery and a request"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1110" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3-1" value="3 · Service discovery and one booking request" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3-2" value="UML sequence diagram. istiod learns Services and pods from the Kubernetes API and pushes them to the proxies; a request then crosses the mesh in an mTLS tunnel without the app changing." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/></mxCell><mxCell id="3-3" value="&lt;b&gt;sd&lt;/b&gt; Discover python and book a session (ambient mode)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=470;height=30;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1560" height="960" as="geometry"/></mxCell><mxCell id="3-4" value="k6 on the host" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eas