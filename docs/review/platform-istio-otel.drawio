lAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1229" y="345" as="sourcePoint"/><mxPoint x="566" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-15" value="a certificate for each pod's identity (SPIFFE)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1229" y="385" as="sourcePoint"/><mxPoint x="566" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-16" value="xDS: listeners and routes from the HTTPRoute" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1229" y="430" as="sourcePoint"/><mxPoint x="351" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-17" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="470" as="sourcePoint"/><mxPoint x="1570" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-18" value="A booking request" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="300" height="24" as="geometry"/></mxCell><mxCell id="3-19" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="339" y="520" width="12" height="385" as="geometry"/></mxCell><mxCell id="3-20" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="554" y="575" width="12" height="295" as="geometry"/></mxCell><mxCell id="3-21" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="769" y="630" width="12" height="205" as="geometry"/></mxCell><mxCell id="3-22" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="984" y="720" width="12" height="40" as="geometry"/></mxCell><mxCell id="3-23" value="POST /v2/bookings + Idempotency-Key" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="525" as="sourcePoint"/><mxPoint x="339" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-24" value="match the route; pick a python endpoint" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="4" y="0" as="offset"/><mxPoint x="351" y="540" as="sourcePoint"/><mxPoint x="351" y="564" as="targetPoint"/><Array as="points"><mxPoint x="391" y="540"/><mxPoint x="391" y="564"/></Array></mxGeometry></mxCell><mxCell id="3-25" value="HBONE: mTLS tunnel on :15008 to sa/python" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="351" y="590" as="sourcePoint"/><mxPoint x="554" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-26" value="check AuthorizationPolicy; deliver on :8080" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="640" as="sourcePoint"/><mxPoint x="769" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-27" value="SQL to postgres:5432 (asyncpg)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="769" y="685" as="sourcePoint"/><mxPoint x="566" y="685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-28" value="mTLS to sa/postgres; check its policy" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="725" as="sourcePoint"/><mxPoint x="984" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-29" value="rows" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="984" y="755" as="sourcePoint"/><mxPoint x="566" y="755" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-30" value="rows" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="790" as="sourcePoint"/><mxPoint x="769" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-31" value="201 Created + booking" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="769" y="830" as="sourcePoint"/><mxPoint x="566" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-32" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="554" y="865" as="sourcePoint"/><mxPoint x="351" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-33" value="201 Created (a retry gets Idempotent-Replayed: true)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="900" as="sourcePoint"/><mxPoint x="136" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3-34" value="&lt;b&gt;Discovery&lt;/b&gt; is the Kubernetes Service name plus xDS. The client still asks for python.wcf-physics.svc; the proxies already know which pods are ready, so they load-balance across them and drop pods that fail readiness." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="470" height="75" as="geometry"/></mxCell><mxCell id="3-35" value="&lt;b&gt;One ztunnel per node&lt;/b&gt; serves every pod on that node, so the same lifeline carries both legs. In sidecar mode each pod has its own Envoy instead, and the gateway talks to python's sidecar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="965" width="470" height="75" as="geometry"/></mxCell><mxCell id="3-36" value="&lt;b&gt;Identity&lt;/b&gt; comes from the pod's ServiceAccount. That is why the plan gives every workload its own account: AuthorizationPolicy names accounts, not IP addresses." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="965" width="520" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="4 Traffic management"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1160" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4-1" value="4 · Traffic management: a mesh retry is a resend unless the request carries a key" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="4-2" value="Routes, timeouts, retries, splits and fault injection are configured in the mesh, not in the app. Retries are where the mesh meets this experiment's rule." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/></mxCell><mxCell id="4-3" value="&lt;b&gt;sd&lt;/b&gt; /naive/bookings with a mesh retry" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=360;height=30;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="740" height="470" as="geometry"/></mxCell><mxCell id="4-4" value="Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-5" value="Mesh proxy" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-6" value="Booking service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-7" value="Records" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-8" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="304" y="245" width="12" height="300" as="geometry"/></mxCell><mxCell id="4-9" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="484" y="280" width="12" height="75" as="geometry"/></mxCell><mxCell id="4-10" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="484" y="420" width="12" height="85" as="geometry"/></mxCell><mxCell id="4-11" value="POST" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="250" as="sourcePoint"/><mxPoint x="304" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-12" value="try 1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="316" y="285" as="sourcePoint"/><mxPoint x="484" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-13" value="booking + charge, committed" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="496" y="320" as="sourcePoint"/><mxPoint x="664" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-14" value="reply lost (connection reset)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="484" y="350" as="sourcePoint"/><mxPoint x="350" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-15" value="" style="ellipse;fillColor=#1E3A8A;strokeColor=#1E3A8A;html=1;" vertex="1" parent="1"><mxGeometry x="342" y="344" width="12" height="12" as="geometry"/></mxCell><mxCell id="4-16" value="retry policy fires" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="322" y="385" width="150" height="20" as="geometry"/></mxCell><mxCell id="4-17" value="try 2, same request" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="316" y="425" as="sourcePoint"/><mxPoint x="484" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-18" value="second booking + second charge" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="496" y="460" as="sourcePoint"/><mxPoint x="664" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-19" value="201 (new booking id)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="484" y="500" as="sourcePoint"/><mxPoint x="316" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-20" value="201" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="304" y="540" as="sourcePoint"/><mxPoint x="136" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-21" value="Two bookings, two charges. The proxy could not tell that try 1 had committed." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="700" height="30" as="geometry"/></mxCell><mxCell id="4-22" value="&lt;b&gt;sd&lt;/b&gt; /v2/bookings with a mesh retry" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=360;height=30;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="740" height="470" as="geometry"/></mxCell><mxCell id="4-23" value="Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-24" value="Mesh proxy" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-25" value="Booking service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-26" value="Records" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=46;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1400" y="175" width="140" height="380" as="geometry"/></mxCell><mxCell id="4-27" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="1104" y="245" width="12" height="300" as="geometry"/></mxCell><mxCell id="4-28" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="1284" y="280" width="12" height="75" as="geometry"/></mxCell><mxCell id="4-29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="1284" y="420" width="12" height="85" as="geometry"/></mxCell><mxCell id="4-30" value="POST + Idempotency-Key" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="936" y="250" as="sourcePoint"/><mxPoint x="1104" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-31" value="try 1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1116" y="285" as="sourcePoint"/><mxPoint x="1284" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-32" value="booking + charge, committed" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1296" y="320" as="sourcePoint"/><mxPoint x="1464" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-33" value="reply lost (connection reset)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1284" y="350" as="sourcePoint"/><mxPoint x="1150" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-34" value="" style="ellipse;fillColor=#1E3A8A;strokeColor=#1E3A8A;html=1;" vertex="1" parent="1"><mxGeometry x="1142" y="344" width="12" height="12" as="geometry"/></mxCell><mxCell id="4-35" value="retry policy fires" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1122" y="385" width="150" height="20" as="geometry"/></mxCell><mxCell id="4-36" value="try 2, same request" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1116" y="425" as="sourcePoint"/><mxPoint x="1284" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-37" value="key seen: read the stored result" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1296" y="460" as="sourcePoint"/><mxPoint x="1464" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-38" value="201 + Idempotent-Replayed: true" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1284" y="500" as="sourcePoint"/><mxPoint x="1116" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-39" value="201" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1104" y="540" as="sourcePoint"/><mxPoint x="936" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-40" value="One booking, one charge. The key turns the resend into a replay." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="560" width="700" height="30" as="geometry"/></mxCell><mxCell id="4-41" value="Route rules for the booking services" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="900" height="30" as="geometry"/></mxCell><mxCell id="4-42" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="665" width="330" height="175" as="geometry"/></mxCell><mxCell id="4-43" value="Timeouts" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46" y="678" width="298" height="26" as="geometry"/></mxCell><mxCell id="4-44" value="A route timeout bounds how long the proxy waits. The spec's client timeout (1 s) stays in k6, so the experiment still sees the same lost replies." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46" y="710" width="298" height="125" as="geometry"/></mxCell><mxCell id="4-45" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="665" width="520" height="175" as="geometry"/></mxCell><mxCell id="4-46" value="Retries" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="396" y="678" width="488" height="26" as="geometry"/></mxCell><mxCell id="4-47" value="&lt;b&gt;/v2/bookings&lt;/b&gt;: retries on reset or 503 are safe, because every try carries the same key. &lt;b&gt;/naive/bookings&lt;/b&gt;: set attempts to 0 so the control group stays naive. Istio's default (2 retries on connection failures, refused streams and retriable codes) targets requests the app never processed; adding reset, 5xx or a per-try timeout can resend a committed request." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="396" y="710" width="488" height="125" as="geometry"/></mxCell><mxCell id="4-48" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="665" width="330" height="175" as="geometry"/></mxCell><mxCell id="4-49" value="Traffic split" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="936" y="678" width="298" height="26" as="geometry"/></mxCell><mxCell id="4-50" value="Weighted routes send, say, 10% of /v2 traffic to a new python version. Watch errors and p99 per version on the dashboard before moving more." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="936" y="710" width="298" height="125" as="geometry"/></mxCell><mxCell id="4-51" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="665" width="330" height="175" as="geometry"/></mxCell><mxCell id="4-52" value="Fault injection" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1286" y="678" width="298" height="26" as="geometry"/></mxCell><mxCell id="4-53" value="The mesh can delay or abort requests, but it does so before the request reaches the app: nothing is booked yet. The experiment needs the reply held after the commit, which only the app's fault hook can do." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1286" y="710" width="298" height="125" as="geometry"/></mxCell><mxCell id="4-54" value="Where the delay happens decides whether a retry duplicates" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="1100" height="30" as="geometry"/></mxCell><mxCell id="4-55" value="Mesh fault injection&lt;br&gt;(delay before the app)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="280" height="50" as="geometry"/></mxCell><mxCell id="4-56" value="proxy holds the request 2 s" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="934" width="720" height="40" as="geometry"/></mxCell><mxCell id="4-57" value="reaches app" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="934" width="90" height="40" as="geometry"/></mxCell><mxCell id="4-58" value="At 1 s the client gives up while nothing is booked yet. The test never reaches the case it exists for: a committed booking whose reply was lost." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="930" width="410" height="60" as="geometry"/></mxCell><mxCell id="4-59" value="App fault hook&lt;br&gt;(the experiment: hold after commit)" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="280" height="50" as="geometry"/></mxCell><mxCell id="4-60" value="app books" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1034" width="90" height="40" as="geometry"/></mxCell><mxCell id="4-61" value="app holds the reply 2 s" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1034" width="720" height="40" as="geometry"/></mxCell><mxCell id="4-62" value="Client gives up at 1 s and retries while the first booking already exists: the naive endpoint books again; the keyed endpoint replays." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1030" width="410" height="60" as="geometry"/></mxCell><mxCell id="4-63" value="client timeout (1 s)" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=none;verticalAlign=top;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="0" y="6" as="offset"/><mxPoint x="690" y="915" as="sourcePoint"/><mxPoint x="690" y="1105" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4-64" value="0 s" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="322" y="1100" width="30" height="20" as="geometry"/></mxCell><mxCell id="4-65" value="2 s" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1100" width="30" height="20" as="geometry"/></mxCell><mxCell id="4-66" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;strokeColor=#64748B;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="1092" as="sourcePoint"/><mxPoint x="1194" y="1092" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="5 Security in three layers"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1195" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5-1" value="5 · Security in three layers: API access, network reach, workload identity" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="5-2" value="Each layer answers a different question, and each one would stop a mistake the others miss." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/></mxCell><mxCell id="5-3" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1540" height="360" as="geometry"/></mxCell><mxCell id="5-4" value="1 · Kubernetes RBAC" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="144" width="280" height="30" as="geometry"/></mxCell><mxCell id="5-5" value="Who may call the Kubernetes API, and do what? Enforced by the API server for every ServiceAccount and user." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="260" height="300" as="geometry"/></mxCell><mxCell id="5-6" value="ServiceAccount or user" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="145" width="320" height="20" as="geometry"/></mxCell><mxCell id="5-7" value="granted" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="145" width="470" height="20" as="geometry"/></mxCell><mxCell id="5-8" value="why" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="145" width="360" height="20" as="geometry"/></mxCell><mxCell id="5-9" value="sa/python, postgres, schema-job, duplicate-audit" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="172" width="320" height="50" as="geometry"/></mxCell><mxCell id="5-10" value="no Role; token not mounted" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="172" width="470" height="50" as="geometry"/></mxCell><mxCell id="5-11" value="They never need the API." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="172" width="360" height="50" as="geometry"/></mxCell><mxCell id="5-12" value="sa/otel-agent" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="234" width="320" height="50" as="geometry"/></mxCell><mxCell id="5-13" value="ClusterRole: get, list, watch pods, namespaces, nodes, nodes/stats, replicasets" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="234" width="470" height="50" as="geometry"/></mxCell><mxCell id="5-14" value="Reads pod CPU and memory from the kubelet and labels telemetry with pod and Deployment names." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="234" width="360" height="50" as="geometry"/></mxCell><mxCell id="5-15" value="sa/otel-cluster" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="296" width="320" height="50" as="geometry"/></mxCell><mxCell id="5-16" value="ClusterRole: get, list, watch Deployments, ReplicaSets, DaemonSets, Jobs, CronJobs, pods, nodes" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="296" width="470" height="50" as="geometry"/></mxCell><mxCell id="5-17" value="Reports desired and ready replicas, restarts and pod phase." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="296" width="360" height="50" as="geometry"/></mxCell><mxCell id="5-18" value="sa/matrix-runner (optional)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="358" width="320" height="50" as="geometry"/></mxCell><mxCell id="5-19" value="Role in wcf-physics: get and patch deployments/scale, only dotnet, java, python" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="358" width="470" height="50" as="geometry"/></mxCell><mxCell id="5-20" value="Lets the matrix scale stacks without cluster-admin, if it ever runs in-cluster." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="358" width="360" height="50" as="geometry"/></mxCell><mxCell id="5-21" value="you (kubeconfig)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="320" height="50" as="geometry"/></mxCell><mxCell id="5-22" value="cluster-admin on your local k3d cluster" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="470" height="50" as="geometry"/></mxCell><mxCell id="5-23" value="make up, make deploy, make exp3-all." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="360" height="50" as="geometry"/></mxCell><mxCell id="5-24" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="1540" height="370" as="geometry"/></mxCell><mxCell id="5-25" value="2 · NetworkPolicy" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="524" width="280" height="30" as="geometry"/></mxCell><mxCell id="5-26" value="Which pods and ports may open a connection? Enforced on the node by k3s's built-in kube-router controller, below the mesh." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="260" height="310" as="geometry"/></mxCell><mxCell id="5-27" value="host (NodePorts)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="170" height="44" as="geometry"/></mxCell><mxCell id="5-28" value="ingress gateway" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="625" width="170" height="44" as="geometry"/></mxCell><mxCell id="5-29" value="dotnet, java" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="690" width="170" height="44" as="geometry"/></mxCell><mxCell id="5-30" value="python :8080" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="590" width="170" height="60" as="geometry"/></mxCell><mxCell id="5-31" value="postgres :5432" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="575" width="170" height="90" as="geometry"/></mxCell><mxCell id="5-32" value="schema-apply, duplicate-audit" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="760" width="170" height="60" as="geometry"/></mxCell><mxCell id="5-33" value="kube-dns :53" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="780" width="150" height="46" as="geometry"/></mxCell><mxCell id="5-34" value="otel-agent :4317" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="780" width="150" height="46" as="geometry"/></mxCell><mxCell id="5-35" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-27" target="5-30"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="582"/><mxPoint x="590" y="602"/></Array></mxGeometry></mxCell><mxCell id="5-36" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-28" target="5-30"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="647"/><mxPoint x="605" y="623"/></Array></mxGeometry></mxCell><mxCell id="5-37" value="denied" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#64748B;fontColor=#64748B;endArrow=cross;endFill=0;endSize=10;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-29" target="5-30"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="712"/><mxPoint x="620" y="644"/></Array></mxGeometry></mxCell><mxCell id="5-38" value="allow 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5-39" value="allow 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-32" target="5-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5-40" value="allow 53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-33"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5-41" value="allow 4317" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-30" target="5-34"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5-42" value="Everything else is denied, including the other stacks reaching python." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="845" width="420" height="22" as="geometry"/></mxCell><mxCell id="5-43" value="allow 5432 (harness counts)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;strokeColor=#64748B;dashed=1;fontColor=#64748B;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5-27" target="5-31"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="532"/><mxPoint x="1075" y="532"/></Array></mxGeometry></mxCell><mxCell id="5-44" value="&lt;b&gt;Start from deny-all&lt;/b&gt; for ingress and egress in wcf-physics, then add one rule per arrow. With ambient mode, also allow port 15008 (HBONE) and the kubelet probe address 169.254.7.127. Risk to prove first: NodePort traffic from the host arrives from the node's address, so the host rules must allow it or k6 and the harness lose access." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="560" width="350" height="150" as="geometry"/></mxCell><mxCell id="5-45" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;opacity=45;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#1E3A8A;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1540" height="265" as="geometry"/></mxCell><mxCell id="5-46" value="3 · Istio identity" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="914" width="280" height="30" as="geometry"/></mxCell><mxCell id="5-47" value="Who is really calling? Proven by the mTLS certificate each pod gets from istiod, and checked by AuthorizationPolicy." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="950" width="260" height="205" as="geometry"/></mxCell><mxCell id="5-48" value="&lt;b&gt;PeerAuthentication&lt;/b&gt; STRICT for wcf-physics: pods accept only mTLS from mesh workloads. The host's plain HTTP must enter through the gateway, or the NodePorts need a PERMISSIVE exception (a decision for the author)." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="380" height="140" as="geometry"/></mxCell><mxCell id="5-49" value="&lt;b&gt;AuthorizationPolicy on postgres&lt;/b&gt; (L4, enforced by ztunnel): ALLOW port 5432 from &lt;i&gt;cluster.local/ns/wcf-physics/sa/&lt;/i&gt; python, dotnet, java, schema-job, duplicate-audit. Everything else is denied." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="750" y="930" width="400" height="140" as="geometry"/></mxCell><mxCell id="5-50" value="&lt;b&gt;AuthorizationPolicy on python&lt;/b&gt; (L7, enforced by the waypoint): ALLOW from the gateway's identity, only POST /naive/bookings, POST /v2/bookings and GET /health." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontFamily=Helvetica;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1180" y="930" width="370" height="140" as="geometry"/></mxCell><mxCell id="5-51" value="&lt;b&gt;Why three layers:&lt;/b&gt; RBAC stops a compromised pod from reading Secrets or scaling Deployments; NetworkPolicy stops connections even if a pod leaves the mesh; Istio stops a pod that can reach the network but holds the wrong identity, and encrypts the traffic." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="1085" width="1210" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-5" name="6 OpenTelemetry and dashboard"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1360" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6-1" value="6 · OpenTelemetry and the dashboard: services, pods and scale" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="6-2" value="The app sends traces and metrics over OTLP; a collector on each node adds pod and node data; one backend stores it and Grafana shows it." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1500" height="48" as="geometry"/></mxCell><mxCell id="6-3" value="sources" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="6-4" value="collectors" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="6-5" value="backend" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="6-6" value="&lt;b&gt;pod python&lt;/b&gt;&lt;br&gt;OTel SDK in bootstrap; FastAPI and asyncpg instrumentation; outcome counter in the HTTP adapter" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="340" height="80" as="geometry"/></mxCell><mxCell id="6-7" value="&lt;b&gt;kubelet&lt;/b&gt; on the node&lt;br&gt;pod and container CPU, memory, network" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="340" height="60" as="geometry"/></mxCell><mxCell id="6-8" value="&lt;b&gt;container logs&lt;/b&gt;&lt;br&gt;/var/log/pods on the node" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="340" height="60" as="geometry"/></mxCell><mxCell id="6-9" value="&lt;b&gt;ztunnel and waypoint&lt;/b&gt;&lt;br&gt;request, TCP and mTLS metrics (Prometheus format)" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="340" height="60" as="geometry"/></mxCell><mxCell id="6-10" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;Deployments: desired and ready replicas, restarts, pod phase" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="340" height="60" as="geometry"/></mxCell><mxCell id="6-11" value="&lt;b&gt;otel-agent&lt;/b&gt;: DaemonSet, one per node&lt;br&gt;&lt;br&gt;receivers: otlp, kubeletstats, filelog, prometheus&lt;br&gt;processors: memory_limiter, k8sattributes, batch&lt;br&gt;exporter: otlp" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="380" height="320" as="geometry"/></mxCell><mxCell id="6-12" value="&lt;b&gt;otel-cluster&lt;/b&gt;: Deployment, 1 replica&lt;br&gt;receiver: k8s_cluster&lt;br&gt;exporter: otlp" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="540" y="530" width="380" height="90" as="geometry"/></mxCell><mxCell id="6-13" value="&lt;b&gt;lgtm&lt;/b&gt;: grafana/otel-lgtm, one pod&lt;br&gt;&lt;br&gt;metrics: Prometheus-compatible store&lt;br&gt;traces: Tempo&lt;br&gt;logs: Loki&lt;br&gt;Grafana with provisioned dashboards" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;dashed=1;dashPattern=6 4;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="6-14" value="&lt;b&gt;you&lt;/b&gt;&lt;br&gt;Grafana on a host port" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="6-15" value="Built for development and demos, not production; enough for one k3d node." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="300" height="40" as="geometry"/></mxCell><mxCell id="6-16" value="OTLP gRPC :4317" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.09375;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-6" target="6-11"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-17" value="kubelet stats API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.375;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-7" target="6-11"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-18" value="files" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.625;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-8" target="6-11"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-19" value="scrape :15020" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.875;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-9" target="6-11"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-20" value="watch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-10" target="6-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-21" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;verticalAlign=bottom;exitX=1;exitY=0.328125;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-11" target="6-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6-22" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="6-12" target="6-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="575"/><mxPoint x="990" y="358"/></Array></mxGeometry></mxCell><mxCell id="6-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B8