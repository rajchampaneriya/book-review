 key belongs to a different booking" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="815" y="723" width="150" height="74" as="geometry"/></mxCell><mxCell id="2-24" value="[same key,&lt;br&gt;different details]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=right;verticalAlign=top;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2-21" target="2-23"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-6" y="2" as="offset"/><Array as="points"><mxPoint x="890" y="640"/></Array></mxGeometry></mxCell><mxCell id="2-25" value="Find the confirmation filed under the key" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="728" width="160" height="64" as="geometry"/></mxCell><mxCell id="2-26" value="[same key,&lt;br&gt;same details]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=top;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="2-21" target="2-25"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="2-27" value="Mark the reply as a repeat" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;"