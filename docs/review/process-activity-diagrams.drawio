middle;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="132" y="1227" width="36" height="36" as="geometry"/></mxCell><mxCell id="1-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="1-47" target="1-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-51" value="Pause 0.2 seconds" style="shape=collate;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="136" y="1306" width="28" height="38" as="geometry"/></mxCell><mxCell id="1-52" value="[fewer than 3 tries]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=top;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="1-49" target="1-51"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="1-53" value="Tell the customer the booking could not be confirmed" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="1217" width="200" height="56" as="geometry"/></mxCell><mxCell id="1-54" value="[3 tries used]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="1-49" target="1-53"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="1-55" value="" style="ellipse;html=1;shape=endState;fillColor=strokeColor;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="375" y="1315" width="30" height="30" as="geometry"/></mxCell><mxCell id="1-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="1-53" target="1-55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-57" value="retry, same details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;horizontal=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1-51" target="1-10"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/><Array as="points"><mxPoint x="60" y="1325"/><mxPoint x="60" y="385"/></Array></mxGeometry></mxCell><mxCell id="1-58" value="The app sends the same details again, but nothing tells the service that this is the same booking." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="305" y="560" width="185" height="85" as="geometry"/></mxCell><mxCell id="1-59" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#64748B;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1-58" target="1-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2 Retry with a key"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1850" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-1" value="2 · Retry with a request key: one booking, however many tries" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1700" height="40" as="geometry"/></mxCell><mxCell id="2-2" value="Every try carries the same request key. The service files the confirmation under the key and, for a repeat, sends the filed confirmation again. Spec: docs/exp3-spec.md, POST /v2/bookings." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1700" height="48" as="geometry"/></mxCell><mxCell id="2-3" value="&lt;b&gt;act&lt;/b&gt; Book a session (with a request key)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=380;height=32;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1780" height="1690" as="geometry"/></mxCell><mxCell id="2-4" value="Customer's app" style="swimlane;html=1;startSize=36;fillColor=#DBEAFE;swimlaneFillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;fontSize=14;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="460" height="1630" as="geometry"/></mxCell><mxCell id="2-5" value="Network" style="swimlane;html=1;startSize=36;fillColor=#DBEAFE;swimlaneFillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;fontSize=14;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="300" height="1630" as="geometry"/></mxCell><mxCell id="2-6" value="Booking service" style="swimlane;html=1;startSize=36;fillColor=#DBEAFE;swimlaneFillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;fontSize=14;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="660" height="1630" as="geometry"/></mxCell><mxCell id="2-7" value="Records" style="swimlane;html=1;startSize=36;fillColor=#DBEAFE;swimlaneFillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;fontSize=14;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="160" width="320" height="1630" as="geometry"/></mxCell><mxCell id="2-8" value="" style="ellipse;fillColor=strokeColor;html=1;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="255" y="200" width="30" height="30" as="geometry"/></mxCell><mxCell id="2-9" value="Customer picks a session and asks to book it" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="267" width="240" height="56" as="geometry"/></mxCell><mxCell id="2-10" value="Give the request a key that every try reuses" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="357" width="240" height="56" as="geometry"/></mxCell><mxCell id="2-11" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="252" y="452" width="36" height="36" as="geometry"/></mxCell><mxCell id="2-12" v