le;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=top;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="2-78" target="2-80"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="2-82" value="Tell the customer the booking could not be confirmed" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="1632" width="200" height="56" as="geometry"/></mxCell><mxCell id="2-83" value="[3 tries used]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=left;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="2-78" target="2-82"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="2-84" value="" style="ellipse;html=1;shape=endState;fillColor=strokeColor;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="375" y="1730" width="30" height="30" as="geometry"/></mxCell><mxCell id="2-85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="2-82" target="2-84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2-86" value="retry, same key and details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackground