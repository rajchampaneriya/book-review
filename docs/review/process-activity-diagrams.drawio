"3-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-11" value="Skip runs already logged for this code version" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="277" width="300" height="56" as="geometry"/></mxCell><mxCell id="3-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-9" target="3-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-13" value="Record the test machine's details" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="365" width="300" height="50" as="geometry"/></mxCell><mxCell id="3-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-11" target="3-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-15" value="Machine details&lt;br&gt;(host.json)" style="html=1;align=center;verticalAlign=middle;rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1325" y="365" width="220" height="50" as="geometry"/></mxCell><mxCell id="3-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-13" target="3-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-17" value="&amp;laquo;iterative&amp;raquo;&amp;nbsp; for each service: .NET, Java, Python" style="dashed=1;rounded=1;absoluteArcSize=1;arcSize=20;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;whiteSpace=wrap;fillColor=none;strokeColor=#3B82F6;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;align=right;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="862" height="965" as="geometry"/></mxCell><mxCell id="3-18" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="610" y="442" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-19" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="630" y="442" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-20" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="650" y="442" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-13" target="3-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-22" value="Switch off the other two services" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="495" width="300" height="50" as="geometry"/></mxCell><mxCell id="3-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-19" target="3-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-24" value="&amp;laquo;proposed&amp;raquo;&lt;br&gt;Start this service and wait until it answers" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="490" y="572" width="300" height="56" as="geometry"/></mxCell><mxCell id="3-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-22" target="3-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-26" value="Warm up: 60 seconds of bookings, not measured" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="655" width="300" height="50" as="geometry"/></mxCell><mxCell id="3-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-24" target="3-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-28" value="Review finding: the harness never starts the service under test again (harness/exp3_matrix.py:115-121), so the Java and Python runs met no running service. Only 18 of 54 runs are valid. TASKS.md step 5." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="555" width="310" height="90" as="geometry"/></mxCell><mxCell id="3-29" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3-28" target="3-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-30" value="&amp;laquo;iterative&amp;raquo;&amp;nbsp; for each of its 18 runs" style="dashed=1;rounded=1;absoluteArcSize=1;arcSize=20;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;whiteSpace=wrap;fillColor=none;strokeColor=#3B82F6;fontColor=#64748B;fontSize=12;fontFamily=Helvetica;align=right;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="830" height="650" as="geometry"/></mxCell><mxCell id="3-31" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="610" y="732" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-32" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="630" y="732" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-33" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="650" y="732" width="20" height="16" as="geometry"/></mxCell><mxCell id="3-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-26" target="3-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-35" value="Clear its bookings, deposits and keys" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="300" height="50" as="geometry"/></mxCell><mxCell id="3-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-32" target="3-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-37" value="Switch reply delays on (restarts the service)" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="852" width="300" height="56" as="geometry"/></mxCell><mxCell id="3-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-35" target="3-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-39" value="Each switch restarts the service and throws away its warm-up. TASKS.md step 8 proposes switching delays on once per service." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="845" width="310" height="70" as="geometry"/></mxCell><mxCell id="3-40" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3-39" target="3-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-41" value="Send 10,000 booking requests at 100 a second. 0%, 1% or 5% of first tries get a reply held for 2 seconds; the app waits 1 second and makes up to 3 tries." style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="935" width="320" height="100" as="geometry"/></mxCell><mxCell id="3-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-37" target="3-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-43" value="Handle every try with the naive or the keyed design (pages 1 and 2)" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="945" width="200" height="80" as="geometry"/></mxCell><mxCell id="3-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="3-41" target="3-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3-45" value="&amp;laquo;datastore&amp;raquo;&lt;br&gt;&lt;b&gt;Bookings, deposits and keys&lt;/b&gt;" style="html=1;align=center;verticalAlign=middle;rounded=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1315" y="955" width="240" height="60" as="geometry"/></mxCell><mxCell id="3-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#