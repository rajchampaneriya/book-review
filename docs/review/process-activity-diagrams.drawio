<mxfile host="drawio" agent="review generator" version="24.7.0"><diagram id="page-0" name="0 How to read"><mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="0-1" value="0 · How to read these diagrams" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1400" height="40" as="geometry"/></mxCell><mxCell id="0-2" value="UML 2.5 activity diagram notation used on pages 1 to 4, and what each symbol means in business terms." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#64748B;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1400" height="48" as="geometry"/></mxCell><mxCell id="0-3" value="&lt;b&gt;act&lt;/b&gt; Notation" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=200;height=32;fillColor=none;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=14;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1460" height="920" as="geometry"/></mxCell><mxCell id="0-4" value='&lt;b&gt;Initial node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;The process starts here.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="168" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-5" value='&lt;b&gt;Activity final node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;The whole process ends here; any other path still running stops too.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-6" value='&lt;b&gt;Flow final node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;This one path ends; other paths carry on.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="336" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-7" value='&lt;b&gt;Action&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;One step that a person or a system carries out.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="420" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-8" value='&lt;b&gt;Send signal action&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Send a message to someone else.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="504" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-9" value='&lt;b&gt;Accept event action&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Wait until a message arrives.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="588" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-10" value='&lt;b&gt;Accept time event action&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Wait until some time has passed.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="672" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-11" value='&lt;b&gt;Decision node with [guards]&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Take exactly one outgoing path: the one whose [condition] is true.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="756" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-12" value='&lt;b&gt;Merge node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Paths come back together here; nothing waits for anything.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-13" value='&lt;b&gt;Fork node (and join node)&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Split into paths that run at the same time; a join waits for all of them.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="924" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-14" value='&lt;b&gt;Control flow&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;What happens next. Guards on it are written in [square brackets].&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="168" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-15" value='&lt;b&gt;Object node and object flow&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;A thing that a step produces or uses.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="252" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-16" value='&lt;b&gt;&amp;laquo;datastore&amp;raquo; node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Records that are kept, such as bookings and deposit charges.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="336" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-17" value='&lt;b&gt;Activity partition (swimlane)&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Who carries out the steps drawn inside it.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-18" value='&lt;b&gt;&amp;laquo;structured&amp;raquo; activity node&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Steps that succeed or fail together: all or nothing.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="504" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-19" value='&lt;b&gt;&amp;laquo;iterative&amp;raquo; expansion region&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;Steps repeated for each item of a list; the boxes on its border hold the list.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="588" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-20" value='&lt;b&gt;Comment&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;An explanation attached with a dashed line; not a step.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="672" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-21" value='&lt;b&gt;&amp;laquo;proposed&amp;raquo; stereotype&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;A step the review recommends and the code does not do yet (a label these diagrams add).&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="756" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-22" value='&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;&lt;font color="#64748B"&gt;The border of one activity diagram (act) with its name.&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E3A8A;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="840" width="490" height="64" as="geometry"/></mxCell><mxCell id="0-23" value="" style="ellipse;fillColor=strokeColor;html=1;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="130" y="185" width="30" height="30" as="geometry"/></mxCell><mxCell id="0-24" value="" style="ellipse;html=1;shape=endState;fillColor=strokeColor;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="130" y="269" width="30" height="30" as="geometry"/></mxCell><mxCell id="0-25" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;backgroundOutline=1;strokeColor=#1E3A8A;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="130" y="353" width="30" height="30" as="geometry"/></mxCell><mxCell id="0-26" value="Take the deposit" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="429" width="150" height="46" as="geometry"/></mxCell><mxCell id="0-27" value="Send request" style="html=1;shape=mxgraph.infographic.ribbonSimple;notch1=0;notch2=18;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;whiteSpace=wrap;spacingRight=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="513" width="150" height="46" as="geometry"/></mxCell><mxCell id="0-28" value="Reply arrives" style="html=1;shape=mxgraph.infographic.ribbonSimple;notch1=18;notch2=0;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;whiteSpace=wrap;spacingLeft=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="597" width="150" height="46" as="geometry"/></mxCell><mxCell id="0-29" value="1 second" style="shape=collate;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="101" y="685" width="28" height="38" as="geometry"/></mxCell><mxCell id="0-30" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="99" y="772" width="32" height="32" as="geometry"/></mxCell><mxCell id="0-31" value="" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" target="0-30"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="788" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="0-32" value="[yes]" style="rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=12;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;align=center;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="0-30"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-2" as="offset"/><mxPoint x="215" y="788" as="targetPoint"/></